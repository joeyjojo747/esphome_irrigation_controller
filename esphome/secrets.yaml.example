# Copy these keys into Device Builder's secrets.yaml (the ESPHome Secrets button)
# and replace every value. All values below are dummies and do nothing useful.
# Generate a real API key with:  openssl rand -base64 32
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
ap_password: "change-me-fallback-ap"
ota_password: "change-me-ota-password"
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
